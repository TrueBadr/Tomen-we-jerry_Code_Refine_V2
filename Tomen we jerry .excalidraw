    {
      "id": "UtS7u1Xpl_i6SCkugLDxQ",
      "type": "text",
      "x": 14.796424441559623,
      "y": -22.75670708550348,
      "width": 993.872957461731,
      "height": 224.24363199869822,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
