    {
      "id": "UHQct_yAUBttlvllfVm3w",
      "type": "text",
      "x": -4012.774863303499,
      "y": 870.014483672006,
      "width": 1818.1595458984375,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
