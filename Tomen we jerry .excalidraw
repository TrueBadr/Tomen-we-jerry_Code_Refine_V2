      "seed": 2137116940,
      "version": 2295,
      "versionNonce": 1570970252,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789377009678,
      "created": 1789373537584,
      "link": null,
      "locked": false,
      "text": "* Candidates and employers can create profiles\n* Candidates and employers can add and update their skills, expertise, experience, and other profile information\n* Employers can define job listings with required skills, experience level, salary range, eligibility criteria, and other relevant information\n* Candidates can search and filter job listings by skills, expertise, experience level, and other criteria\n* The system can recommend candidates to employers based on skills, expertise, and experience level\n* Candidates can apply for jobs\n* Employers can search and filter candidates by skills, expertise, experience level, and other criteria\n* The system analyzes the skill gap between a candidate's profile and a target job based on required skills and experience\n* Employers can review applications\n* The system can recommend jobs to candidates based on skills, expertise, and experience level\n* Employers can move candidates through the application pipeline\n* The system sends notifications for relevant events",
      "fontSize": 14.949575466579882,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Candidates and employers can create profiles\n* Candidates and employers can add and update their skills, expertise, experience, and other profile information\n* Employers can define job listings with required skills, experience level, salary range, eligibility criteria, and other relevant information\n* Candidates can search and filter job listings by skills, expertise, experience level, and other criteria\n* The system can recommend candidates to employers based on skills, expertise, and experience level\n* Candidates can apply for jobs\n* Employers can search and filter candidates by skills, expertise, experience level, and other criteria\n* The system analyzes the skill gap between a candidate's profile and a target job based on required skills and experience\n* Employers can review applications\n* The system can recommend jobs to candidates based on skills, expertise, and experience level\n* Employers can move candidates through the application pipeline\n* The system sends notifications for relevant events",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
